{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sintonize",
  "version": "0.1.0",
  "identifier": "com.sintonize.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @sintonize/web dev",
    "devUrl": "http://localhost:3000/admin",
    "beforeBuildCommand": "pnpm --filter @sintonize/web build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sintonize — Estação Central",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "url": "http://localhost:3000/admin",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,WebRtcHideLocalIpsWithMdns --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
